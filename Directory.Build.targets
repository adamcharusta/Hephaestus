<Project>

  <!-- Exit code 8 is "no tests ran". A test project that holds none yet sets AllowNoTests in its project file and drops it
       when its story adds the first test; every other test project fails when no test runs. This file is evaluated after
       the project file, which is why the condition cannot live in Directory.Build.props. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(AllowNoTests)' == 'true'">
    <TestingPlatformCommandLineArguments>--ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

</Project>
