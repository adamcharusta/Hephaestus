# Credentials for the injection spike. Copy to ".env" in this directory and fill
# in what you have. ".env" is ignored by git; never commit it.
#
# A mode whose credential is missing is recorded as not-run, and the report
# treats that mode as unverified.

# Claude Code, API key mode. Create a key in the Claude Console.
ANTHROPIC_API_KEY=

# Claude Code, subscription sign-in. Run `claude setup-token` on your own
# machine and paste the token it prints.
CLAUDE_CODE_OAUTH_TOKEN=

# Codex CLI, API key mode. Create a key on the OpenAI platform.
OPENAI_API_KEY=

# Codex CLI, subscription sign-in. Run `codex login` on your own machine, then
# give the path of the credential file it wrote (usually ~/.codex/auth.json).
# Use forward slashes, for example C:/Users/you/.codex/auth.json. The file is
# read, never changed.
#
# Sign in just before the run. The spike gives each container a copy of the
# file and throws the copy away. Should Codex refresh the sign-in during a run,
# the refreshed copy is lost and your own file may stop working: sign in again
# with `codex login`. Each result records whether the file was rewritten.
CODEX_AUTH_JSON_PATH=

# Optional: models to use. Leave empty for the cheapest Claude alias and for
# Codex's own default.
SPIKE_CLAUDE_MODEL=haiku
SPIKE_CODEX_MODEL=

# Codex under subscription sign-in: empty means the CLI default for a ChatGPT account.
SPIKE_CODEX_SUBSCRIPTION_MODEL=
