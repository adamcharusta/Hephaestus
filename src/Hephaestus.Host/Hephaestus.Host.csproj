<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The one executable is the host (`hephaestus serve`) and the command line (every other argument), AD-17. The image
         names the published executable `hephaestus` (deploy/Dockerfile); the assembly keeps the project's name. -->
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Methodologies the image ships (AD-14), beside the executable, where DirectoryMethodologyCatalog looks for them. -->
    <Content Include="..\..\methodologies\**\*" Link="methodologies\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The lock the host reads at every start (AD-8), beside the executable, where HostSettings looks for it. The image holds no Agent binary. -->
    <Content Include="..\..\deploy\agents.lock" Link="agents.lock" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hephaestus.Core\Hephaestus.Core.csproj" />
    <ProjectReference Include="..\Hephaestus.Agents\Hephaestus.Agents.csproj" />
    <ProjectReference Include="..\Hephaestus.GitHub\Hephaestus.GitHub.csproj" />
    <ProjectReference Include="..\Hephaestus.Workspaces\Hephaestus.Workspaces.csproj" />
    <ProjectReference Include="..\Hephaestus.Persistence\Hephaestus.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hephaestus.Host.Tests" />
    <!-- The end-to-end harness starts the host itself (Story 3.3). -->
    <InternalsVisibleTo Include="Hephaestus.EndToEnd.Tests" />
  </ItemGroup>

</Project>
