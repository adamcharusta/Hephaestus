<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The one executable is the host (`hephaestus serve`) and the command line (every other argument), AD-17. The image
         names the published executable `hephaestus` (deploy/Dockerfile); the assembly keeps the project's name. -->
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hephaestus.Core\Hephaestus.Core.csproj" />
    <ProjectReference Include="..\Hephaestus.Agents\Hephaestus.Agents.csproj" />
    <ProjectReference Include="..\Hephaestus.GitHub\Hephaestus.GitHub.csproj" />
    <ProjectReference Include="..\Hephaestus.Workspaces\Hephaestus.Workspaces.csproj" />
    <ProjectReference Include="..\Hephaestus.Persistence\Hephaestus.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hephaestus.Host.Tests" />
  </ItemGroup>

</Project>
