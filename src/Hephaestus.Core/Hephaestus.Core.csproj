<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- One resource set per language, both embedded in this assembly. WithCulture="false" keeps `.pl` in the name instead
         of building a satellite assembly, because the build runs in globalization-invariant mode, which cannot create
         the `pl` culture that a satellite lookup needs. -->
    <EmbeddedResource Update="Localization\Messages.*.resx" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hephaestus.Core.Tests" />
  </ItemGroup>

</Project>
