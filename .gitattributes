# Everything runs in Linux containers, so text is stored and checked out with LF,
# whatever the host. A CRLF in a shell script or a Dockerfile breaks the build.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Scripts and container files: always LF.
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.lock text eol=lf

# Better diffs.
*.cs text diff=csharp
*.md text diff=markdown
*.html text diff=html
*.css text diff=css
*.scss text diff=css

# Generated files: collapsed in pull request diffs.
package-lock.json linguist-generated=true
**/Migrations/*.Designer.cs linguist-generated=true
**/Migrations/*ModelSnapshot.cs linguist-generated=true

# Binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
*.gz binary
*.bundle binary
*.db binary
*.snk binary
