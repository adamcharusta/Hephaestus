<Project>

  <!-- Every package version lives here, at the versions the architecture spine's Stack table pins (AR-3).
       Only free and open-source packages are added (NFR-15); eng/check-licenses.py enforces that. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Pinned by the Stack table; referenced by the story that first uses each">
    <PackageVersion Include="Docker.DotNet.Enhanced" Version="4.4.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Octokit" Version="14.0.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup Label="Test tooling the Stack table does not pin">
    <!-- Coverage under xunit.v3's Microsoft.Testing.Platform runner. MIT. -->
    <PackageVersion Include="coverlet.mtp" Version="10.1.1" />
  </ItemGroup>

</Project>
